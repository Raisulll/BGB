// BIRDS — PostgreSQL schema (CLAUDE.md §17). Spec #30.
// Constraints Prisma cannot express (CHECK constraints, append-only triggers, the audit hash chain)
// live in the hand-written SQL appended to the init migration — see prisma/sql/integrity.sql.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// §17.2
model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique @db.VarChar(50)
  description String?
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// §17.3
model RolePermission {
  id      Int     @id @default(autoincrement())
  role    String  @db.VarChar(50)
  pageId  String  @map("page_id") @db.VarChar(50)
  enabled Boolean @default(true)
  roleRef Role    @relation(fields: [role], references: [name], onUpdate: Cascade)

  @@unique([role, pageId])
  @@map("role_permissions")
}

// §17.1 — plus must_change_password (admin reset flow, spec #29)
model User {
  id                 String    @id @db.VarChar(10)
  username           String    @unique @db.VarChar(50)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  name               String    @db.VarChar(100)
  role               String    @db.VarChar(50)
  scope              String    @db.VarChar(100)
  email              String    @unique @db.VarChar(150)
  isActive           Boolean   @default(true) @map("is_active")
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLogin          DateTime? @map("last_login") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  roleRef              Role                      @relation(fields: [role], references: [name], onUpdate: Cascade)
  incidents            Incident[]
  timeline             IncidentTimeline[]
  comments             IncidentComment[]
  evidence             Evidence[]
  notifications        Notification[]
  configUpdates        SystemConfig[]
  conversationsCreated Conversation[]            @relation("ConversationCreator")
  memberships          ConversationMember[]
  pushSubscriptions    PushSubscription[]
  membersRemoved       ConversationMember[]      @relation("MemberRemovedBy")
  joinRequestsFor      ConversationJoinRequest[] @relation("JoinRequestUser")
  joinRequestsMade     ConversationJoinRequest[] @relation("JoinRequestRequester")
  joinRequestsDecided  ConversationJoinRequest[] @relation("JoinRequestDecider")
  messagesSent         Message[]
  callsMade            Call[]                    @relation("CallCaller")
  callsReceived        Call[]                    @relation("CallCallee")
  refreshTokens        RefreshToken[]

  @@map("users")
}

// §17.4
model OrgHierarchy {
  id        Int    @id @default(autoincrement())
  hq        String @default("HQ") @db.VarChar(50)
  sector    String @db.VarChar(50)
  battalion String @db.VarChar(50)
  bop       String @db.VarChar(100)

  @@unique([sector, battalion, bop])
  @@map("org_hierarchy")
}

// §17.5
model IncidentCategory {
  id            String                @id @db.VarChar(10)
  name          String                @unique @db.VarChar(100)
  isActive      Boolean               @default(true) @map("is_active")
  subcategories IncidentSubcategory[]

  @@map("incident_categories")
}

model IncidentSubcategory {
  id         Int              @id @default(autoincrement())
  categoryId String           @map("category_id") @db.VarChar(10)
  name       String           @db.VarChar(100)
  isActive   Boolean          @default(true) @map("is_active")
  category   IncidentCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, name])
  @@map("incident_subcategories")
}

// §17.6 — status/severity CHECK constraints are in prisma/sql/integrity.sql
model Incident {
  id              String    @id @db.VarChar(30)
  title           String    @db.VarChar(255)
  category        String    @db.VarChar(100)
  subcategory     String?   @db.VarChar(100)
  severity        String    @db.VarChar(20)
  status          String    @db.VarChar(20)
  incidentDate    DateTime  @map("incident_date") @db.Date
  incidentTime    DateTime  @map("incident_time") @db.Time(0)
  location        String?   @db.VarChar(255)
  bop             String?   @db.VarChar(100)
  sector          String?   @db.VarChar(50)
  battalion       String?   @db.VarChar(50)
  lat             Decimal?  @db.Decimal(10, 7)
  lng             Decimal?  @db.Decimal(10, 7)
  description     String
  personsInvolved String?   @map("persons_involved")
  actionTaken     String?   @map("action_taken")
  outcome         String?
  createdBy       String    @map("created_by") @db.VarChar(10)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  // Spec #45 — set when a Closed/Rejected incident is archived; archived records leave the default
  // lists and statistics but are never deleted
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz
  archivedBy      String?   @map("archived_by") @db.VarChar(10)
  // A draft its creator discarded (never submitted). Timeline rows are append-only, so the record
  // stays in the database, hidden from every view; only Drafts can be discarded (DB CHECK)
  discardedAt     DateTime? @map("discarded_at") @db.Timestamptz
  discardedBy     String?   @map("discarded_by") @db.VarChar(10)
  // When the current status began (overdue indicator). Kept by a DB trigger on every status change
  statusChangedAt DateTime  @default(now()) @map("status_changed_at") @db.Timestamptz

  creator       User               @relation(fields: [createdBy], references: [id])
  timeline      IncidentTimeline[]
  comments      IncidentComment[]
  evidence      Evidence[]
  notifications Notification[]

  @@index([status], map: "idx_incidents_status")
  @@index([sector], map: "idx_incidents_sector")
  @@index([incidentDate], map: "idx_incidents_date")
  @@index([category], map: "idx_incidents_category")
  @@index([sector, status], map: "idx_incidents_sector_status")
  @@index([createdBy, status], map: "idx_incidents_creator_status")
  @@index([archivedAt], map: "idx_incidents_archived")
  @@index([status, statusChangedAt], map: "idx_incidents_status_since")
  @@map("incidents")
}

// §17.7 — append-only (UPDATE/DELETE blocked by trigger)
model IncidentTimeline {
  id         Int      @id @default(autoincrement())
  incidentId String   @map("incident_id") @db.VarChar(30)
  action     String   @db.VarChar(50)
  userName   String   @map("user_name") @db.VarChar(100)
  userId     String?  @map("user_id") @db.VarChar(10)
  status     String   @db.VarChar(20)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([incidentId, createdAt])
  @@map("incident_timeline")
}

// Discussion on an incident, separate from workflow actions. Append-only like the timeline
// (DB triggers): a comment is part of the record and is never edited or deleted.
model IncidentComment {
  id         Int      @id @default(autoincrement())
  incidentId String   @map("incident_id") @db.VarChar(30)
  userId     String   @map("user_id") @db.VarChar(10)
  userName   String   @map("user_name") @db.VarChar(100)
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id])

  @@index([incidentId, createdAt])
  @@map("incident_comments")
}

// §17.8 — deleted_at supports the soft-delete in §19.4
model Evidence {
  id           Int       @id @default(autoincrement())
  incidentId   String    @map("incident_id") @db.VarChar(30)
  fileName     String    @map("file_name") @db.VarChar(255)
  originalName String    @map("original_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(100)
  fileSize     BigInt    @map("file_size")
  storagePath  String    @map("storage_path") @db.VarChar(500)
  // SHA-256 of the stored bytes, for chain-of-custody verification (null for seed placeholders)
  sha256       String?   @db.VarChar(64)
  fileMetadata Json?     @map("file_metadata")
  uploadedBy   String?   @map("uploaded_by") @db.VarChar(10)
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  uploader User?    @relation(fields: [uploadedBy], references: [id])

  @@index([incidentId])
  @@map("evidence")
}

// §17.9 — tamper-evident: seq/prev_hash/row_hash are set by a trigger (SHA-256 hash chain);
// UPDATE/DELETE/TRUNCATE raise an exception. See prisma/sql/integrity.sql and DOUBT-005.
model AuditLog {
  id        Int      @id @default(autoincrement())
  seq       BigInt?  @unique
  timestamp DateTime @default(now()) @db.Timestamptz
  userId    String?  @map("user_id") @db.VarChar(10)
  username  String   @db.VarChar(50)
  action    String   @db.VarChar(100)
  details   String?
  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent")
  prevHash  String?  @map("prev_hash") @db.VarChar(64)
  rowHash   String?  @map("row_hash") @db.VarChar(64)

  @@index([timestamp])
  @@index([username])
  @@index([action])
  @@map("audit_log")
}

// §17.10
model Notification {
  id             Int      @id @default(autoincrement())
  userId         String?  @map("user_id") @db.VarChar(10)
  title          String   @db.VarChar(200)
  message        String
  type           String?  @db.VarChar(50)
  isRead         Boolean  @default(false) @map("is_read")
  incidentId     String?  @map("incident_id") @db.VarChar(30)
  conversationId Int?     @map("conversation_id") // group notifications open the conversation
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User?         @relation(fields: [userId], references: [id])
  incident     Incident?     @relation(fields: [incidentId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([userId, isRead])
  @@map("notifications")
}

// §17.11
model SystemConfig {
  key         String   @id @db.VarChar(100)
  value       String
  description String?
  updatedBy   String?  @map("updated_by") @db.VarChar(10)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  updater User? @relation(fields: [updatedBy], references: [id])

  @@map("system_config")
}

// §17.12 — one row per login session; the token is rotated in place on refresh.
// previous_token_hash + rotated_at detect refresh-token reuse; last_seen_at enforces idle timeout (spec #28).
model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.VarChar(10)
  tokenHash         String    @unique @map("token_hash") @db.VarChar(255)
  previousTokenHash String?   @map("previous_token_hash") @db.VarChar(255)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  ipAddress         String?   @map("ip_address") @db.Inet
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revoked           Boolean   @default(false)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(50)

  user              User               @relation(fields: [userId], references: [id])
  pushSubscriptions PushSubscription[]

  @@index([userId, revoked])
  @@index([previousTokenHash])
  @@map("refresh_tokens")
}

// Spec #23 — transactional outbox for workflow e-mails. Rows are written in the same transaction
// as the workflow change and sent afterwards by the mail worker (src/modules/notifications/mailer.ts).
model EmailOutbox {
  id            Int       @id @default(autoincrement())
  toUserId      String?   @map("to_user_id") @db.VarChar(10)
  toEmail       String    @map("to_email") @db.VarChar(150)
  subject       String    @db.VarChar(255)
  bodyText      String    @map("body_text")
  event         String    @db.VarChar(30)
  incidentId    String?   @map("incident_id") @db.VarChar(30)
  status        String    @default("pending") @db.VarChar(10) // pending | sent | failed
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  sentAt        DateTime? @map("sent_at") @db.Timestamptz

  @@index([status, nextAttemptAt], map: "idx_email_outbox_due")
  @@map("email_outbox")
}

// ---------------------------------------------------------------------------
// Messaging and calls (spec #58 extension). Messages are permanent records (append-only DB
// triggers); voice notes go through the evidence storage driver, so they are encrypted at rest
// like evidence (spec #27). Calls are 1:1 WebRTC audio; only the call record is kept, never audio.
// ---------------------------------------------------------------------------
model Conversation {
  id             Int       @id @default(autoincrement())
  kind           String    @db.VarChar(10) // 'direct' | 'group' (DB CHECK)
  title          String?   @db.VarChar(100) // groups only
  // Direct conversations: both user ids sorted and joined with ':', so a pair has exactly one thread
  directKey      String?   @unique @map("direct_key") @db.VarChar(25)
  createdBy      String    @map("created_by") @db.VarChar(10)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastMessageAt  DateTime? @map("last_message_at") @db.Timestamptz
  // Group photo, stored encrypted like voice messages; changed only by group admins
  coverPath      String?   @map("cover_path") @db.VarChar(500)
  coverMime      String?   @map("cover_mime") @db.VarChar(50)
  coverSha256    String?   @map("cover_sha256") @db.VarChar(64)
  coverUpdatedAt DateTime? @map("cover_updated_at") @db.Timestamptz

  creator       User                      @relation("ConversationCreator", fields: [createdBy], references: [id])
  members       ConversationMember[]
  messages      Message[]
  joinRequests  ConversationJoinRequest[]
  notifications Notification[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId Int       @map("conversation_id")
  userId         String    @map("user_id") @db.VarChar(10)
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  leftAt         DateTime? @map("left_at") @db.Timestamptz // members who leave keep their row (history)
  lastReadId     Int       @default(0) @map("last_read_id") // highest message id this member has read
  role           String    @default("member") @db.VarChar(10) // groups: 'admin' | 'member' (DB CHECK)
  removedBy      String?   @map("removed_by") @db.VarChar(10) // set when an admin removed them (left_at too)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id])
  remover      User?        @relation("MemberRemovedBy", fields: [removedBy], references: [id])

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

// A browser/device that receives web push for a user (calls, messages). Bound to the sign-in
// session it was registered in: pushes stop when that session is signed out, revoked or expired.
model PushSubscription {
  id            Int       @id @default(autoincrement())
  userId        String    @map("user_id") @db.VarChar(10)
  sessionId     String    @map("session_id") @db.Uuid
  endpoint      String    @unique @db.VarChar(1000)
  p256dh        String    @db.VarChar(200)
  auth          String    @db.VarChar(100)
  userAgent     String?   @map("user_agent") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz

  user    User         @relation(fields: [userId], references: [id])
  session RefreshToken @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// A member's request to add someone to a group; an admin approves or rejects it
model ConversationJoinRequest {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  userId         String    @map("user_id") @db.VarChar(10) // the person to be added
  requestedBy    String    @map("requested_by") @db.VarChar(10)
  status         String    @default("pending") @db.VarChar(10) // pending | approved | rejected | cancelled (DB CHECK)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  decidedBy      String?   @map("decided_by") @db.VarChar(10)
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user         User         @relation("JoinRequestUser", fields: [userId], references: [id])
  requester    User         @relation("JoinRequestRequester", fields: [requestedBy], references: [id])
  decider      User?        @relation("JoinRequestDecider", fields: [decidedBy], references: [id])

  @@index([conversationId, status])
  @@map("conversation_join_requests")
}

model Message {
  id              Int      @id @default(autoincrement())
  conversationId  Int      @map("conversation_id")
  senderId        String   @map("sender_id") @db.VarChar(10)
  kind            String   @db.VarChar(10) // 'text' | 'voice' | 'system' | 'call' (DB CHECK)
  body            String? // text, the wording of a system event, or a plain summary of a call
  voicePath       String?  @map("voice_path") @db.VarChar(500)
  voiceMime       String?  @map("voice_mime") @db.VarChar(100)
  voiceSize       Int?     @map("voice_size")
  voiceDurationMs Int?     @map("voice_duration_ms")
  voiceSha256     String?  @map("voice_sha256") @db.VarChar(64)
  // kind 'call': the finished call this entry records (sender = the caller)
  callId          Int?     @unique @map("call_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User         @relation(fields: [senderId], references: [id])
  call         Call?        @relation(fields: [callId], references: [id], onDelete: Restrict)

  @@index([conversationId, id])
  @@map("messages")
}

model Call {
  id         Int       @id @default(autoincrement())
  callerId   String    @map("caller_id") @db.VarChar(10)
  calleeId   String    @map("callee_id") @db.VarChar(10)
  // ringing -> answered -> ended, or ringing -> declined | missed | cancelled | failed (DB CHECK)
  status     String    @db.VarChar(12)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz
  answeredAt DateTime? @map("answered_at") @db.Timestamptz
  endedAt    DateTime? @map("ended_at") @db.Timestamptz
  endReason  String?   @map("end_reason") @db.VarChar(40)

  caller  User     @relation("CallCaller", fields: [callerId], references: [id])
  callee  User     @relation("CallCallee", fields: [calleeId], references: [id])
  message Message?

  @@index([callerId, startedAt])
  @@index([calleeId, startedAt])
  @@map("calls")
}
