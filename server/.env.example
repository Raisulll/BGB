# BIRDS API — copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL (spec #30). Use a dedicated least-privilege role, not the postgres superuser.
DATABASE_URL=postgresql://birds:CHANGE_ME@localhost:5432/birds?schema=public
# Connection pool size per process; recommended (CPU cores * 2) + 1 (§26)
DB_POOL_MAX=9

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173

# Express "trust proxy" setting so req.ip is the client IP: the Nginx address in production, or a hop
# count behind a hosting load balancer (1 on Render)
TRUST_PROXY=loopback

# Serve the built SPA (BGB/dist) from this process — single-service hosting such as the Render demo.
# Leave unset when Nginx serves the SPA (production layout).
# SERVE_SPA_DIR=../BGB/dist

# JWT RS256 key pair (spec #28). Generate with: npm run keys
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_ISSUER=birds-api
JWT_AUDIENCE=birds-web
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=8

# bcrypt cost factor (§20)
BCRYPT_ROUNDS=12
# Requests per minute per signed-in user (§20 default 100). Development builds of the SPA double
# requests (React StrictMode), and browser test runs reload pages constantly: use e.g. 1000 locally.
API_RATE_LIMIT_PER_MINUTE=100

# Evidence storage (specs #10, #33). local: a dedicated volume or NAS mount, included in backups.
# s3: any S3-compatible store (MinIO, AWS S3, Supabase Storage); the bucket must be private.
STORAGE_DRIVER=local
EVIDENCE_DIR=storage/evidence
# S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3   (unset = AWS S3)
# S3_REGION=ap-southeast-1
# S3_BUCKET=evidence
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
EVIDENCE_MAX_FILE_MB=50
EVIDENCE_MAX_INCIDENT_MB=500
EVIDENCE_MAX_FILES_PER_UPLOAD=10
# Evidence encryption at rest (spec #27): AES-256-GCM, 32 random bytes base64 — generate with
# `npm run keys:evidence`. REQUIRED in production. Keep it with the backups: without it, stored
# evidence cannot be read. Files stored before a key was set stay readable.
EVIDENCE_ENCRYPTION_KEY=

# Logging (spec #48). Production path per §25: /var/log/birds
# Workflow e-mail (spec #23). Leave SMTP_HOST empty to disable e-mail (in-app notifications still work).
# MAIL_TRANSPORT=smtp|json|none overrides the default (smtp when SMTP_HOST is set).
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); with false, STARTTLS is used when the server offers it
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BIRDS <birds-noreply@bgb.gov.bd>
# Origin of the web app, used for links in e-mails
APP_BASE_URL=http://localhost:5173

# API documentation: /api/v1/openapi.json + Swagger UI at /api/docs.
# Unset = on in development/test, off in production. Set true to publish it in production.
# API_DOCS=false

# Audio calls (WebRTC). Browsers find each other through STUN; when a firewall or NAT blocks a
# direct path, audio is relayed through TURN. Demo: a free hosted relay. Production: BGB's own
# coturn server (turn:/turns: URLs, comma-separated). Credentials are given to signed-in users only.
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turns:turn.example.org:5349,turn:turn.example.org:3478?transport=udp
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Seconds an unanswered call rings before it is recorded as missed (1-120)
CALL_RING_SECONDS=30

LOG_LEVEL=info
LOG_DIR=logs
