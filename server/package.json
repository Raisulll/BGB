{
  "name": "birds-server",
  "version": "0.1.0",
  "private": true,
  "description": "BIRDS backend API - Border Guard Bangladesh",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "keys": "tsx scripts/generate-keys.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:demo": "tsx prisma/demo/demo-seed.ts",
    "db:demo:docs": "tsx prisma/demo/make-docs.ts",
    "db:reset": "prisma migrate reset",
    "db:start": "pg_ctl -D .pgdata -l .pgdata/server.log -w start",
    "db:stop": "pg_ctl -D .pgdata -w stop",
    "demo:reset-user": "tsx scripts/reset-demo-user.ts",
    "map:download": "tsx scripts/map-download.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "keys:vapid": "web-push generate-vapid-keys",
    "keys:evidence": "node -e \"console.log('EVIDENCE_ENCRYPTION_KEY=' + require('node:crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "web-push": "3.6.7",
    "winston": "^3.19.0",
    "ws": "^8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "3.6.4",
    "@types/ws": "^8.18.1",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.23.1"
  }
}
