# BIRDS frontend (Vite). Copy to .env.local to override. Only VITE_* values reach the browser bundle.

# Where the SPA sends API calls. Keep it same-origin (/api/v1) so the httpOnly refresh cookie
# stays first-party; the dev server and Nginx proxy /api to the backend.
VITE_API_BASE=/api/v1

# Dev/preview server only: where Vite proxies /api (not bundled).
BIRDS_API_TARGET=http://localhost:4000

# Show the demo-account shortcuts on the login page in a production build (TEC demonstration only).
# They always show under `npm run dev`. Never enable on a real deployment.
VITE_SHOW_DEMO_ACCOUNTS=false
